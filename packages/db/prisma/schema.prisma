datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now())
  email      String?    @unique
  name       String?
  role       Role       @default(USER)

  activities Activity[]
  jobRuns    JobRun[]
  stravaConnection StravaConnection?
  sessions Session[]
  weeklyPlans WeeklyPlan[]
  weeklyGoals WeeklyGoals?
}

model WeeklyGoals {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runMinutes Int?
  bikeMinutes Int?
  swimMinutes Int?
}

model WeeklyPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
}

model StravaConnection {
  userId       Int      @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId    BigInt   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String[]
  lastSuccessfulSyncAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  tokenHash String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model OAuthState {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model Activity {
  id              Int            @id @default(autoincrement())
  name            String?
  userId          Int
  user            User           @relation(fields: [userId], references: [id])

  type            ActivityType
  startedAt       DateTime
  durationSeconds Int
  distanceMeters  Int?
  elevationMeters Int?

  load            Int?
  relativeEffort  Int?

  source          ActivitySource @default(STRAVA)
  stravaActivityId BigInt?       @unique

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, startedAt])
}

model JobRun {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  status     JobStatus  @default(PENDING)
  error      String?
  activityCount Int     @default(0)
  attemptsStarted Int   @default(0)
  nextRetryAt DateTime?
  leaseExpiresAt DateTime?

  jobType    SyncJobType @default(STRAVA_SYNC)

  userId     Int
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum ActivityType {
  BIKE
  RUN
  SWIM
  OTHER
}

enum ActivitySource {
  STRAVA
  MANUAL
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum SyncJobType {
  STRAVA_SYNC
  COMPUTE_PLAN
}

enum Role {
  USER
  ADMIN
}
