datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now())
  email      String?    @unique
  name       String?
  role       Role       @default(USER)
  timeZone   String     @default("UTC")
  athleteProfile AthleteProfile?
  raceGoals RaceGoal[]
  performanceEvidence PerformanceEvidence[]
  developmentBlocks DevelopmentBlock[]

  activities Activity[]
  jobRuns    JobRun[]
  stravaConnection StravaConnection?
  sessions Session[]
  weeklyPlans WeeklyPlan[]
  weeklyGoals WeeklyGoals?
}

model WeeklyGoals {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runMinutes Int?
  bikeMinutes Int?
  swimMinutes Int?
}

model DevelopmentBlock {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  plannedEndDate DateTime @db.Date
  phase String
  status DevelopmentBlockStatus @default(ACTIVE)
  revision Int @default(1)
  // Original proposal is immutable. Reviews append decisions and future pattern changes.
  content Json
  reviews DevelopmentBlockReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
  // A partial unique index in the migration permits only one ACTIVE block per athlete.
}

model DevelopmentBlockReview {
  id Int @id @default(autoincrement())
  blockId Int
  block DevelopmentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  revision Int
  reviewedWeekStart DateTime @db.Date
  effectiveWeekStart DateTime @db.Date
  decision String
  content Json
  createdAt DateTime @default(now())

  @@unique([blockId, revision])
}

enum DevelopmentBlockStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

model WeeklyPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime
  content   Json
  workoutStates Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
}

// Versioned domain JSON avoids a table for every profile setting. Evidence and
// races are relational because history, dates, and ownership need direct queries.
model AthleteProfile {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Json
  updatedAt DateTime @updatedAt
}

model RaceGoal {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  importance Int
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model PerformanceEvidence {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport ActivityType
  metric String
  benchmark Float
  value Float
  occurredAt DateTime
  sourceActivityId Int?
  sourceActivity Activity? @relation(fields: [sourceActivityId], references: [id], onDelete: SetNull)
  source String
  isPersonalRecord Boolean
  methodVersion String
  createdAt DateTime @default(now())

  @@index([userId, sport, metric, benchmark, occurredAt], map: "PerformanceEvidence_user_benchmark_date_idx")
}

model StravaConnection {
  userId       Int      @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId    BigInt   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String[]
  lastSuccessfulSyncAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  tokenHash String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model OAuthState {
  tokenHash String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model Activity {
  id              Int            @id @default(autoincrement())
  name            String?
  userId          Int
  user            User           @relation(fields: [userId], references: [id])

  type            ActivityType
  startedAt       DateTime
  durationSeconds Int
  distanceMeters  Int?
  elevationMeters Int?

  load            Int?
  relativeEffort  Int?

  source          ActivitySource @default(STRAVA)
  stravaActivityId BigInt?       @unique

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  performanceEvidence PerformanceEvidence[]

  @@index([userId, startedAt])
}

model JobRun {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  status     JobStatus  @default(PENDING)
  error      String?
  activityCount Int     @default(0)
  attemptsStarted Int   @default(0)
  nextRetryAt DateTime?
  leaseExpiresAt DateTime?

  planRequest Json?
  jobType    SyncJobType @default(STRAVA_SYNC)

  userId     Int
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum ActivityType {
  BIKE
  RUN
  SWIM
  OTHER
}

enum ActivitySource {
  STRAVA
  MANUAL
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum SyncJobType {
  STRAVA_SYNC
  COMPUTE_PLAN
}

enum Role {
  USER
  ADMIN
}
