# Keep existing Postgres credentials when updating an existing checkout.
POSTGRES_USER=planner
POSTGRES_PASSWORD=local_development_password
POSTGRES_DB=strava
DATABASE_URL=postgresql://planner:local_development_password@localhost:5432/strava
REDIS_URL=redis://localhost:6379

# Add your own API app credentials; never commit real secrets.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
