# Copy to apps/worker/.env.local. Never put the API key in apps/web or NEXT_PUBLIC_*.
# The worker also reads existing infrastructure variables from the root .env.
PLANNER_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.6-luna
OPENAI_PLANNER_TIMEOUT_MS=75000
OPENAI_PLANNER_MAX_OUTPUT_TOKENS=16000
